---
import { Image } from "astro:assets";
import ProductCard from "@/components/ProductCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import heroImg from "@/assets/atelier-hero.jpg";
import { getProjects } from "@/data/products.js";

const projects = await getProjects();
const featured = projects.slice(0, 3);
---

<BaseLayout
  title="Bryan Kettle — AI/ML Engineer"
  description="Deep learning, neural networks, and generative AI. Mathematics PhD. State Street."
  image={heroImg}
>
  <main id="main-content">
  <h1 class="sr-only">Bryan Kettle — AI/ML Engineer</h1>
  <section class="relative overflow-hidden bg-base">
    <div class="md:hidden">
      <div class="aspect-[4/3] w-full">
        <Image
          src={heroImg}
          alt="Neural networks and deep learning"
          width={1600}
          height={1280}
          format="webp"
          loading="eager"
          decoding="sync"
          class="h-full w-full object-cover object-right"
        />
      </div>
      <div class="space-y-6 px-6 py-12">
        <p class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
          <span class="inline-block h-px w-8 bg-ink/40"></span>
          AI/ML Engineer · Mathematics PhD
        </p>
        <p class="text-balance font-serif text-4xl leading-[0.95]">
          Deep learning
          <br />
          <span class="italic text-accent">at scale.</span>
        </p>
        <p class="max-w-[48ch] text-pretty leading-relaxed text-faded">
          Building neural networks and production ML systems. Combining mathematical rigor with practical engineering for problems that matter.
        </p>
        <div class="flex flex-col items-start gap-4 pt-2 sm:flex-row sm:items-center">
          <a
            href="/projects"
            class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent"
          >
            View projects
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          </a>
          <a href="/about" class="text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink">
            About →
          </a>
        </div>
      </div>
    </div>

    <div class="relative hidden h-[88vh] max-h-[920px] min-h-[640px] w-full md:block">
      <Image
        src={heroImg}
        alt="Neural networks and deep learning"
        width={1600}
        height={1280}
        format="webp"
        loading="eager"
        decoding="sync"
        class="absolute inset-0 h-full w-full object-cover object-right"
      />
      <div
        aria-hidden="true"
        class="absolute inset-0"
        style="background: linear-gradient(90deg, var(--color-base) 0%, var(--color-base) 30%, color-mix(in oklab, var(--color-base) 55%, transparent) 45%, color-mix(in oklab, var(--color-base) 5%, transparent) 65%, transparent 80%)"
      >
      </div>
      <div
        aria-hidden="true"
        class="absolute inset-x-0 bottom-0 h-40"
        style="background: linear-gradient(180deg, transparent, var(--color-base))"
      >
      </div>
      <div class="relative mx-auto flex h-full max-w-screen-xl items-center px-6">
        <div class="max-w-[480px] space-y-8">
          <p class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
            <span class="inline-block h-px w-8 bg-ink/40"></span>
            AI/ML Engineer · Mathematics PhD
          </p>
          <p class="text-balance font-serif text-5xl leading-[0.95] lg:text-6xl">
            Deep learning
            <br />
            <span class="italic text-accent">at scale.</span>
          </p>
          <p class="max-w-[48ch] text-pretty leading-relaxed text-faded md:text-lg">
            Building neural networks and production ML systems. Combining mathematical rigor with practical engineering for problems that matter.
          </p>
          <div class="flex items-center gap-6 pt-2">
            <a
              href="/projects"
              class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent"
            >
              View projects
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </a>
            <a href="/about" class="text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink">
              About →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-screen-xl px-6 pt-24 md:pt-32">
    <div class="mb-12 flex items-end justify-between gap-6 border-t border-line pt-10">
      <div>
        <p class="mb-4 text-[11px] uppercase tracking-[0.3em] text-faded">Recent Work</p>
        <h2 class="max-w-[20ch] text-balance font-serif text-3xl md:text-5xl">
          Models in production, <span class="italic text-accent">deployed at scale.</span>
        </h2>
      </div>
      <a
        href="/projects"
        class="hidden items-center gap-2 whitespace-nowrap text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink md:inline-flex"
      >
        View all
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 gap-x-8 gap-y-12 md:grid-cols-3">
      {featured.map((project) => <ProductCard product={project} />)}
    </div>

    <div class="mt-10 flex justify-center md:hidden">
      <a href="/projects" class="inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink">
        View all projects →
      </a>
    </div>
  </section>

  <section class="mx-auto mt-32 max-w-screen-xl px-6 md:mt-48">
    <div class="border-t border-line pt-12">
      <p class="mb-4 text-[11px] uppercase tracking-[0.3em] text-faded">Areas of Focus</p>
      <h2 class="mb-12 max-w-[22ch] text-balance font-serif text-3xl md:text-5xl">
        Deep learning, <span class="italic text-accent">deployed right</span>.
      </h2>
      <div class="grid gap-x-8 gap-y-10 md:grid-cols-3">
        {
          [
            {
              name: "Deep Learning",
              tag: "Neural Networks · Transformers",
              copy: "Designing and training neural networks for perception, prediction, and generation. From CNNs to attention mechanisms.",
            },
            {
              name: "Generative AI",
              tag: "LLMs · Fine-tuning · Inference",
              copy: "Working with large language models, from fine-tuning and prompt engineering to deployment and optimization.",
            },
            {
              name: "Production ML",
              tag: "Deployment · Monitoring · Scale",
              copy: "Building systems that work: versioning, canary deployments, performance monitoring, and automated rollback.",
            },
          ].map((focus) => (
            <div class="space-y-3 pt-2">
              <p class="text-[10px] uppercase tracking-[0.3em] text-faded">{focus.tag}</p>
              <h3 class="font-serif text-2xl">{focus.name}</h3>
              <p class="text-sm leading-relaxed text-faded">{focus.copy}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</main>
</BaseLayout>
          <p class="hidden pt-2 text-center text-sm text-accent" data-newsletter-success aria-live="polite">
            You're on the list. We'll be in touch.
          </p>
        </form>
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Atelier Kō",
    url: Astro.site?.href ?? "https://atelier-ko-topaz.vercel.app/",
    slogan: "Furniture, made by hand",
    address: {
      "@type": "PostalAddress",
      addressRegion: "Småland",
      addressCountry: "SE",
    },
  })}></script>

  <script is:inline>
    const form = document.querySelector("[data-newsletter-form]");
    if (form) {
      const button = form.querySelector("[data-newsletter-button]");
      const success = form.querySelector("[data-newsletter-success]");

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        button.disabled = true;
        button.textContent = "Saving...";
        window.setTimeout(() => {
          form.reset();
          button.disabled = false;
          button.textContent = "Notify me";
          success.classList.remove("hidden");
        }, 450);
      });
    }
  </script>
  </main>
</BaseLayout>
